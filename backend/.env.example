DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=showman_fashion
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Use SQLite for local dev without PostgreSQL
USE_SQLITE=False

# Optional single connection URL for Render, Neon, Supabase, or another cloud PostgreSQL provider.
# When set, this takes precedence over the DB_* values above.
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (for verification & password reset)
# Local development can use the console backend. Use the SMTP backend in Render
# or another deployed environment so OTPs are actually delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=The Show Man <theshowmanfashion@gmail.com>
GOOGLE_CLIENT_ID=968497314939-k13s816ek41kt5n6doteucesd8aj2cp6.apps.googleusercontent.com
# Gmail: use an App Password, never your normal Gmail password.
# EMAIL_HOST_USER=theshowmanfashion@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-google-app-password

# Payment gateway (Razorpay is shown at checkout only when both keys are set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# API rate limits
ANON_THROTTLE_RATE=5000/hour
USER_THROTTLE_RATE=10000/hour
